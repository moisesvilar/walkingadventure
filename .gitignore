# Datos pesados locales (no van al repo).
# Rutas ANCLADAS con "/": sin la barra inicial, "data/" también hacía match con
# js/data/ y se tragó silenciosamente js/data/overpass.js (nunca se commiteó).
/data/
/overpass-db/
/.cache/
.DS_Store

# Credenciales locales (clave de Magnific). Ya no se usa —los scripts de generación
# de sprites se borraron—, pero la regla se queda: nunca al repo.
/.env

# Material de referencia y pruebas sueltas. Son imágenes de terceros usadas como
# inspiración de estilo, no fuente del proyecto.
/temp/

# Dependencias y artefactos de la app de Expo. Rutas ANCLADAS, como todas las de
# arriba: "node_modules/" sin barra inicial también valdría, pero la costumbre del
# repo es anclar y el precedente de "data/" explica por qué.
/node_modules/
/app/node_modules/
/packages/nucleo/node_modules/
/app/.expo/
/app/ios/
/app/android/
/app/dist/

# Reports de ejecución de pruebas: se regeneran, no se versionan. El .gitkeep sí,
# porque el runner debe encontrar el directorio en un clon limpio (y lo crea si no
# está, pero un clon donde ya existe es una cosa menos que explicar).
/test/reports/*
!/test/reports/.gitkeep
